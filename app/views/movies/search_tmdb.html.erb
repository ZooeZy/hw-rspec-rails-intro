
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

<h2>Search in TMDb</h2>

<!-- Display warning messages -->
<% if flash[:warning].present? %>
  <div class="alert alert-warning">
    <%= flash[:warning] %>
  </div>
<% end %>

<!-- Search Form -->
<div class="search-container">

  <%= form_tag search_tmdb_path, method: :get, id: 'tmdb_form' do %>

    <label for="movie_title_field">Movie Name</label>
    <%= text_field_tag 'title', params[:title],
        class: "form-control",
        id: "movie_title_field",
        placeholder: "Manhunter" %>

    <label for="movie_year_field">Release Year</label>
    <%= text_field_tag 'release_year', params[:release_year],
        class: "form-control",
        id: "movie_year_field",
        placeholder: "1986" %>

    <div class="form-check">
      <%= radio_button_tag 'language', 'en',
          params[:language] == 'en',
          class: "form-check-input" %>
      <label class="form-check-label" for="language_en">
        English Only
      </label>
    </div>

    <div class="form-check">
      <%= radio_button_tag 'language', 'all',
          params[:language] != 'en',
          class: "form-check-input" %>
      <label class="form-check-label" for="language_all">
        All Languages
      </label>
    </div>

    <%= submit_tag 'Search',
        id: 'tmdb_submit',
        class: 'btn btn-warning col-2' %>

  <% end %>

</div>

<!-- Search Results -->
<% if @movies.present? %>

  <h3 class="mt-4">Search Results</h3>

  <table class="table table-striped" id="search_movies">

    <thead>
      <tr>
        <th>Movie Title</th>
        <th>Rating</th>
        <th>Release Date</th>
        <th>Add Movie</th>
      </tr>
    </thead>

    <tbody>

      <% @movies.each do |movie| %>

        <tr>
          <td><%= movie.title %></td>
          <td><%= movie.rating %></td>
          <td><%= movie.release_date %></td>

          <td>
            <%= form_tag add_movie_path, method: :post do %>

              <%= hidden_field_tag :title, movie.title %>
              <%= hidden_field_tag :rating, movie.rating %>
              <%= hidden_field_tag :release_date, movie.release_date %>
              <%= hidden_field_tag :description, movie.description %>

              <%= submit_tag 'Add Movie',
                  class: 'btn btn-success' %>

            <% end %>
          </td>
        </tr>

      <% end %>

    </tbody>

  </table>

<% end %>

<!-- Back to Movies -->
<div class="mt-4">
  <%= link_to 'Back to Movies',
      movies_path,
      class: 'btn btn-secondary' %>
</div>
